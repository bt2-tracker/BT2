#include <winver.h>
#include "ft2_header.h" // PROG_VER_STR
#include "bt2_version.h" // BT2_VERSION (BerntTracker)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
FILETYPE        VFT_APP

BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription",  "Bernttracker II"
			VALUE "ProductName",      "Bernttracker II"
			VALUE "ProductVersion",   BT2_VERSION
#ifdef _WIN64
			VALUE "InternalName",     "Bernttracker II"
			VALUE "OriginalFilename", "Bernttracker II.exe"
#else
			VALUE "InternalName",     "ft2-clone-win32"
			VALUE "OriginalFilename", "ft2-clone-win32.exe"
#endif
			VALUE "LegalCopyright",   "Copyright © Olav ""8bitbubsy"" Sørensen"
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END

IDI_MAIN_ICON ICON "gfxdata/icon/bt2.ico" // BerntTracker: the same icon as the web version

// BerntTracker: the logo on the start screen (the same picture as the web version's)
BT2LOGO RCDATA "../web/bt2-logo.png"
BT2NEWS RCDATA "../web/nytt.txt"
